<odoo>
    <record id="purchase_request_view_form" model="ir.ui.view">
        <field name="name">purchase.request.form (spareparts)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="equipment_id" />
            </xpath>
        </field>
    </record>

    <record id="purchase_request_line_view_tree" model="ir.ui.view">
        <field name="name">purchase.request.line.tree (spareparts)</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="purchase_request.purchase_request_line_tree" />
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="domain">[
                    ('purchase_ok', '=', True)
                ]</attribute>
            </field>
        </field>
    </record>

    <record id="purchase_request_line_view_form" model="ir.ui.view">
        <field name="name">purchase.request.line.form (spareparts)</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="purchase_request.purchase_request_line_form" />
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="domain">[
                    ('purchase_ok', '=', True)
                ]</attribute>
            </field>
        </field>
    </record>
</odoo>
