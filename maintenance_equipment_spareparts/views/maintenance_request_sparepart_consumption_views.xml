<odoo>
    <record id="maintenance_request_sparepart_consumption_view_tree" model="ir.ui.view">
        <field name="name">maintenance.request.sparepart.consumption.tree</field>
        <field name="model">maintenance.request.sparepart.consumption</field>
        <field name="arch" type="xml">
            <list string="Spare Parts Consumption">
                <field name="product_id" />
                <field name="consumed_qty" />
                <field name="state" />
                <field name="stock_picking_id" invisible="state != 'consumed'" />
                <field name="purchase_request_id" invisible="state != 'requested'" />
            </list>
        </field>
    </record>

    <record id="maintenance_request_sparepart_consumption_view_form" model="ir.ui.view">
        <field name="name">maintenance.request.sparepart.consumption.form</field>
        <field name="model">maintenance.request.sparepart.consumption</field>
        <field name="arch" type="xml">
            <form string="Spare Part Consumption">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id" />
                            <field name="sparepart_id" />
                            <field name="product_id" />
                            <field name="consumed_qty" />
                            <field name="state" />
                        </group>
                        <group>
                            <field
                                name="stock_picking_id"
                                invisible="state != 'consumed'"
                            />
                            <field
                                name="purchase_request_id"
                                invisible="state != 'requested'"
                            />
                            <field
                                name="purchase_request_line_id"
                                invisible="state != 'requested'"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
