<odoo>
    <record id="equipment_request_view_form" model="ir.ui.view">
        <field name="name">equipment.request.form (spareparts)</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="base_maintenance.equipment_request_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_purchase_requests"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    groups="purchase.group_purchase_user"
                    invisible="purchase_request_count == 0"
                >
                    <field
                        name="purchase_request_count"
                        widget="statinfo"
                        string="Purchase Requests"
                    />
                </button>
            </xpath>
            <xpath expr="//page[@name='description_page']" position="after">
                <page
                    string="Spare Parts"
                    name="spareparts"
                    invisible="not equipment_id"
                >
                    <group>
                        <group>
                            <field name="sparepart_ids" readonly="1" nolabel="1">
                                <list string="Equipment Spare Parts">
                                    <field name="product_id" />
                                    <field name="installed_qty" />
                                    <field name="spare_qty" />
                                    <field name="available_qty" />
                                    <field
                                        name="needs_reorder"
                                        widget="boolean_toggle"
                                    />
                                </list>
                            </field>
                            <button
                                name="action_consume_spareparts"
                                type="object"
                                string="Consume Spare Parts"
                                invisible="not allow_consumptions"
                                groups="stock.group_stock_user"
                                class="oe_link"
                            />
                        </group>
                    </group>
                </page>
                <page
                    string="Purchase Requests"
                    name="purchase_requests"
                    groups="purchase.group_purchase_user"
                    invisible="purchase_request_count == 0"
                >
                    <field name="purchase_request_ids" nolabel="1" readonly="1">
                        <list string="Purchase Requests">
                            <field name="name" />
                            <field name="origin" />
                            <field name="requested_by" />
                            <field name="state" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
