<odoo>
    <record model="ir.ui.view" id="maintenance_request_form_view">
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="base_maintenance.equipment_request_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
                    name="inspection"
                    string="Inspection"
                    invisible="maintenance_type != 'preventive' or not has_inspection"
                >
                    <group>
                        <field name="inspection_closed_at" readonly="1" />
                        <field name="inspection_closed_by" readonly="1" />
                    </group>
                    <field
                        name="inspection_line_ids"
                        mode="list,kanban"
                        readonly="inspection_closed_at"
                    />
                    <field name="has_inspection" invisible="1" />
                </page>
            </notebook>
            <button name="archive_equipment_request" position="after">
                <button
                    name="set_inspection"
                    type="object"
                    string="Set inspection"
                    invisible="has_inspection or maintenance_type != 'preventive'"
                />
                <button
                    name="finish_inspection"
                    type="object"
                    string="Finish inspection"
                    invisible="not has_inspection or inspection_closed_at or maintenance_type != 'preventive'"
                />
            </button>
        </field>
    </record>
</odoo>
