<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="maintenance_equipment_certificate_view_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.certificate.list</field>
        <field name="model">maintenance.equipment.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="certificate_number" />
                <field name="equipment_id" />
                <field name="date" />
                <field name="renewal_date" />
                <field name="notes" optional="hide" />
            </list>
        </field>
    </record>

    <record id="maintenance_equipment_certificate_view_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.certificate.form</field>
        <field name="model">maintenance.equipment.certificate</field>
        <field name="arch" type="xml">
            <form>
                <field name="active" invisible="1" />
                <widget
                    name="web_ribbon"
                    title="Archived"
                    bg_color="text-bg-danger"
                    invisible="active"
                />
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="certificate_number" />
                            <field name="equipment_id" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="renewal_date" />
                        </group>
                    </group>
                    <group>
                        <field name="notes" />
                        <field name="certificate_filename" invisible="1" />
                        <field
                            name="certificate_file"
                            filename="certificate_filename"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maintenance_equipment_certificate_view_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.certificate.search</field>
        <field name="model">maintenance.equipment.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="certificate_number" />
                <field name="equipment_id" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <filter
                    name="expiring"
                    string="Expiring"
                    domain="[('renewal_date', '!=', False)]"
                />
                <group>
                    <filter
                        name="group_by_equipment"
                        string="Equipment"
                        context="{'group_by': 'equipment_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="maintenance_equipment_certificate_action" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">maintenance.equipment.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_maintenance_certificate"
        name="Certificates"
        parent="maintenance.menu_maintenance_configuration"
        action="maintenance_equipment_certificate_action"
        groups="maintenance.group_equipment_manager,base.group_user"
        sequence="3"
    />
</odoo>
