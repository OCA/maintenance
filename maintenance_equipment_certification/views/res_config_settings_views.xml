<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.maintenance.equipment.certification
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="maintenance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='maintenance']" position="inside">
                <block title="Certifications">
                    <setting
                        string="Expiration Alert"
                        help="Send an email notification when a certificate is about to expire."
                    >
                        <field name="cert_expiration_notify_enabled" />
                        <div
                            class="content-group"
                            invisible="not cert_expiration_notify_enabled"
                        >
                            <div class="mt16">
                                <a
                                    type="action"
                                    name="%(certificate_reminder_rule_action)d"
                                >Configure Reminder Rules</a>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
