<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="certificate_reminder_rule_view_list" model="ir.ui.view">
        <field name="name">maintenance.certificate.reminder.rule.list</field>
        <field name="model">maintenance.certificate.reminder.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="days_before" />
            </list>
        </field>
    </record>

    <record id="certificate_reminder_rule_action" model="ir.actions.act_window">
        <field name="name">Certificate Reminder Rules</field>
        <field name="res_model">maintenance.certificate.reminder.rule</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_certificate_reminder_rule"
        name="Certificate Reminder Rules"
        parent="maintenance.menu_maintenance_configuration"
        action="certificate_reminder_rule_action"
        groups="maintenance.group_equipment_manager"
        sequence="4"
    />
</odoo>
