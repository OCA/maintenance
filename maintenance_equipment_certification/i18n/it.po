#. module: maintenance_equipment_certification
#: model:mail.template,description:maintenance_equipment_certification.mail_template_certificate_expiration
msgid ""
"\n"
"            Sent automatically when a certificate is approaching its renewal "
"date.\n"
"        "
msgstr ""

#. module: maintenance_equipment_certification
#: model:mail.template,body_html:maintenance_equipment_certification.mail_template_certificate_expiration
msgid ""
"<div>\n"
"                <t t-set=\"user\" t-"
"value=\"object.equipment_id.technician_user_id or "
"object.equipment_id.owner_user_id\"/>\n"
"                Dear <t t-out=\"user.name or 'Team'\">Team</t>,\n"
"                <br/><br/>\n"
"                The following certificate is approaching its expiration "
"date\n"
"                and requires your attention:\n"
"                <br/><br/>\n"
"                <strong>Certificate:</strong>\n"
"                <t t-out=\"object.name or ''\">Certificate name</t>\n"
"                <br/>\n"
"                <t t-if=\"object.certificate_number\">\n"
"                <strong>Number:</strong>\n"
"                <t t-out=\"object.certificate_number\">CERT-001</t>\n"
"                <br/>\n"
"            </t>\n"
"                <strong>Equipment:</strong>\n"
"                <t t-out=\"object.equipment_id.name or ''\">Equipment name</"
"t>\n"
"                <br/>\n"
"                <strong>Renewal Date:</strong>\n"
"                <t t-out=\"format_date(object.renewal_date)\">2026-12-31</"
"t>\n"
"                <br/><br/>\n"
"                Please take the necessary steps to renew this certificate\n"
"                before it expires.\n"
"            </div>\n"
"        "
msgstr ""

