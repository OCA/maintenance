<odoo>
    <record id="group_maintenance_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence" eval="5" />
        <field name="privilege_id" ref="maintenance.res_groups_privilege_maintenance" />
    </record>
    <record id="maintenance.group_equipment_manager" model="res.groups">
        <field name="privilege_id" ref="maintenance.res_groups_privilege_maintenance" />
        <field name="implied_ids" eval="[(4, ref('group_maintenance_user'))]" />
    </record>
    <record id="group_maintenance_manager" model="res.groups">
        <field name="name">Full Access</field>
        <field name="sequence" eval="20" />
        <field name="privilege_id" ref="maintenance.res_groups_privilege_maintenance" />
        <field
            name="implied_ids"
            eval="[(4, ref('maintenance.group_equipment_manager')), (4, ref('group_maintenance_user'))]"
        />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <!-- Deactivate base read-all access on maintenance.team for base.group_user -->
    <record id="maintenance.access_maintenance_team_user" model="ir.access">
        <field name="active" eval="False" />
    </record>

    <!-- Restrict maintenance user to their subscribed maintenance teams -->
    <record id="only_subscribe_maintenance_team" model="ir.access">
        <field name="name">Only Subscribe Maintenance Team</field>
        <field name="model_id" ref="maintenance.model_maintenance_team" />
        <field name="group_id" ref="group_maintenance_user" />
        <field name="operation">crud</field>
        <field name="domain">[('member_ids', 'in', [user.id])]</field>
    </record>
</odoo>
