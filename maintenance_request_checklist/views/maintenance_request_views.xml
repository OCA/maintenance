<odoo>
    <record id="equipment_request_view_form" model="ir.ui.view">
        <field name="name">equipment.request.form.checklist</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="base_maintenance.equipment_request_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='description_page']" position="before">
                <page name="checklist_page" string="Checklist">
                    <group>
                        <group>
                            <field name="checklist_done" string="Steps Done" />
                            <field name="checklist_total" string="Total Steps" />
                        </group>
                    </group>
                    <field name="checklist_ids">
                        <tree
                            editable="bottom"
                            decoration-success="is_done"
                            decoration-muted="not is_done"
                        >
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="is_done" />
                            <field name="done_by" />
                            <field name="done_date" />
                            <field name="meter_value" />
                            <field name="notes" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
